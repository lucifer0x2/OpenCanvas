{
  "name": "opencanvas-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node --test --test-concurrency=1 tests/state.test.ts tests/node-links.test.ts tests/preview-keyframes.test.ts tests/preview-model.test.ts tests/diagnostics.test.ts",
    "test:actions": "node tests/node-actions-smoke.mjs",
    "test:preview": "node tests/preview-smoke.mjs",
    "test:browser": "node tests/smoke.mjs",
    "test:zoom": "node tests/zoom.mjs"
  },
  "dependencies": {
    "konva": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.0.2",
    "vite": "^8.0.0"
  }
}
